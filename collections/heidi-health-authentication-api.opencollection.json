{
  "opencollection": "1.0.0",
  "info": {
    "name": "Heidi Health Ask Heidi Authentication API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Exchange API Key For JWT",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://registrar.api.heidihealth.com/api/v2/ml-scribe/open-api/jwt",
            "params": [
              {
                "name": "email",
                "value": "",
                "type": "query"
              },
              {
                "name": "third_party_internal_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Heidi-Api-Key",
              "value": "{{Heidi-Api-Key}}",
              "placement": "header"
            }
          },
          "docs": "Exchange a tenant Heidi API key for a short-lived bearer JWT bound to an EHR user."
        }
      ]
    }
  ],
  "bundled": true
}
{
  "item": [
    {
      "id": "3e163681-7d8f-4602-b3c1-01a7d6befdce",
      "name": "Authentication",
      "description": {
        "content": "Token exchange.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3dd73ddf-5fa8-42a3-ad88-7739f9084c2e",
          "name": "Exchange API Key For JWT",
          "request": {
            "name": "Exchange API Key For JWT",
            "description": {
              "content": "Exchange a tenant Heidi API key for a short-lived bearer JWT bound to an EHR user.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "jwt"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "email",
                  "value": "<email>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "third_party_internal_id",
                  "value": "<string>",
                  "description": "(Required) "
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "Heidi-Api-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
          "response": [
            {
              "id": "14009017-cc94-43ff-b2a5-a13b2b189f67",
              "name": "Token issued.",
              "originalRequest": {
                "url": {
                  "path": [
                    "jwt"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "email",
                      "value": "<email>"
                    },
                    {
                      "key": "third_party_internal_id",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "Heidi-Api-Key",
                    "value": "<API Key>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"token\": \"string\",\n  \"expiration_time\": \"2021-02-09T20:49:16.576Z\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://registrar.api.heidihealth.com/api/v2/ml-scribe/open-api",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}"
      }
    ]
  },
  "info": {
    "_postman_id": "b4910d58-a582-4e4b-9832-2e583e658484",
    "name": "Heidi Health Ask Heidi Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Heidi API lets partner platforms (EHRs, telehealth apps, custom clinician\ntools) drive Heidi's ambient documentation engine end-to-end:\nauthentication via tenant API key + per-user JWT, patient profile\nmanagement, session lifecycle (create, update, list, retrieve),\ncontextual attachments and linked sessions, audio upload (single file or\nchunked live), transcript retrieval (final or live-chunked), template\ndiscovery, streamed consult-note and document generation against Heidi\nor custom templates, multi-standard clinical coding (ICD-10/SNOMED/CPT\nand others), and streamed Ask Heidi assistant responses.\n\nDocumentation: https://www.heidihealth.com/developers/heidi-api/overview\n\n\nContact Support:\n Name: Heidi Health Support",
      "type": "text/plain"
    }
  }
}
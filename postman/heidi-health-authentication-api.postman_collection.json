      "updatedAt": "2026-07-28T01:54:16.000Z",
      "uid": "35240-77951dfc-7371-46f0-beaf-cbcd829f4ba2"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{bearerToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://registrar.api.heidihealth.com/api/v2/ml-scribe/open-api"
    }
  ]
}